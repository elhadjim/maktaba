---
import BaseLayout from './BaseLayout.astro';
import SlideDeck from '../components/SlideDeck.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  path: string;
  title: string;
  description: string;
  body: string;
}

const { locale, path, title, description, body } = Astro.props;
---

<BaseLayout locale={locale} path={path} title={title} description={description}>
  <h1>{title}</h1>
  <SlideDeck body={body} />
</BaseLayout>
