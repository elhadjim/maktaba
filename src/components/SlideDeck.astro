---
// `?url` (not a plain CSS import) keeps these out of Astro's page-wide CSS
// bundle so reveal.js styles only ship on pages that render a slide deck.
import revealCssUrl from 'reveal.js/reveal.css?url';
import revealThemeUrl from 'reveal.js/theme/white.css?url';

interface Props {
  /** Raw markdown body of the deck, slides separated by --- (and -- for vertical nav) */
  body: string;
}

const { body } = Astro.props;
---

<link rel="stylesheet" href={revealCssUrl} />
<link rel="stylesheet" href={revealThemeUrl} />

<div class="reveal" data-pagefind-ignore>
  <div class="slides">
    <section data-markdown data-separator="^\r?\n---\r?\n$" data-separator-vertical="^\r?\n--\r?\n$">
      <textarea data-template set:html={body} />
    </section>
  </div>
</div>

<script>
  import Reveal from 'reveal.js';
  import Markdown from 'reveal.js/plugin/markdown';

  const el = document.querySelector<HTMLElement>('.reveal');
  if (el) {
    const deck = new Reveal(el, { plugins: [Markdown], hash: true });
    deck.initialize();
  }
</script>

<style>
  .reveal {
    height: 70vh;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    margin-block: 1.5rem;
  }
</style>
