---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LOCALES, type Locale } from '../i18n/ui';

interface Props {
  currentLocale: Locale;
  /** Path within the locale, e.g. "/", "/blog", "/blog/mon-article" */
  path: string;
}

const { currentLocale, path } = Astro.props;

const labels: Record<Locale, string> = { fr: 'FR', ar: 'AR', en: 'EN' };
---

<nav class="lang-switcher" aria-label="Changer de langue">
  {
    LOCALES.map((locale) => (
      <a
        href={getRelativeLocaleUrl(locale, path)}
        aria-current={locale === currentLocale ? 'true' : undefined}
      >
        {labels[locale]}
      </a>
    ))
  }
</nav>
