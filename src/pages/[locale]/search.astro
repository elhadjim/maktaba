---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Search from 'astro-pagefind/components/Search.astro';
import { useTranslations, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return (['ar', 'en'] as const).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout locale={locale} path="/search" title={t('nav.search')}>
  <h1>{t('nav.search')}</h1>
  <Search
    searchboxOptions={{
      placeholder: t('search.placeholder'),
      filters: { locale }
    }}
  />
</BaseLayout>
