---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocaleEntries, slugFromId } from '../../../lib/content-helpers';
import { SECTIONS, SECTION_SLUGS, type SectionSlug } from '../../../lib/sections';
import { useTranslations, sectionLabels, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  const paths = [];
  for (const locale of ['ar', 'en'] as const) {
    for (const section of SECTION_SLUGS) {
      paths.push({ params: { locale, section } });
    }
  }
  return paths;
}

const { locale, section } = Astro.params as { locale: Locale; section: SectionSlug };
const entries = await getLocaleEntries(SECTIONS[section], locale);
const t = useTranslations(locale);
const label = sectionLabels(locale)[section];
---

<BaseLayout locale={locale} path={`/${section}`} title={label}>
  <h1>{label}</h1>
  {entries.length === 0 && <p>{t('section.empty')}</p>}
  <ul class="entry-list">
    {
      entries.map((entry) => (
        <li class="entry-list__item">
          <h2>
            <a href={`/${locale}/${section}/${slugFromId(entry.id)}`}>{entry.data.title}</a>
          </h2>
          <p class="entry-list__meta">{entry.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
