---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleEntries, slugFromId } from '../../lib/content-helpers';
import { SECTIONS, SECTION_SLUGS, type SectionSlug } from '../../lib/sections';
import { useTranslations, sectionLabels } from '../../i18n/ui';

export function getStaticPaths() {
  return SECTION_SLUGS.map((section) => ({ params: { section } }));
}

const { section } = Astro.params as { section: SectionSlug };
const locale = 'fr' as const;
const entries = await getLocaleEntries(SECTIONS[section], locale);
const t = useTranslations(locale);
const label = sectionLabels(locale)[section];
---

<BaseLayout locale={locale} path={`/${section}`} title={label}>
  <h1>{label}</h1>
  {entries.length === 0 && <p>{t('section.empty')}</p>}
  <ul class="entry-list">
    {
      entries.map((entry) => (
        <li class="entry-list__item">
          <h2>
            <a href={`/${section}/${slugFromId(entry.id)}`}>{entry.data.title}</a>
          </h2>
          <p class="entry-list__meta">{entry.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
